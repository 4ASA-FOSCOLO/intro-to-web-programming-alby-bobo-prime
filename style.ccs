<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Centro Sportivo Albi e Bobo</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            line-height: 1.6;
            color: #333;
        }
        
        .hero {
            background-color: #00bfff;
            color: white;
            text-align: center;
            padding: 100px 20px;
        }
        
        .hero h1 {
            font-size: 3.5rem;
            margin-bottom: 20px;
        }
        
        .hero p {
            font-size: 1.5rem;
        }
        
        section {
            padding: 60px 20px;
            max-width: 1000px;
            margin: 0 auto;
        }
        
        h2 {
            font-size: 2rem;
            text-align: center;
            margin-bottom: 30px;
        }
        
        ul {
            list-style: none;
            padding: 0;
        }
        
        li {
            background-color: #f8f9fa;
            margin: 10px 0;
            padding: 15px;
            border-radius: 8px;
            font-size: 1.2rem;
        }
        
        footer {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 20px;
        }
    </style>
</head>
<body>

    <!-- HERO SECTION -->
    <div class="hero">
        <h1>Centro Sportivo Albi e Bobo</h1>
        <p>Il tuo centro sportivo che offre tutti questi sport</p>
    </div>

    <!-- IDENTITÀ / CHI SIAMO -->
    <section>
        <h2>Chi siamo</h2>
        <p style="text-align: center; font-size: 1.3rem;">
            Siamo il <strong>Centro Sportivo Albi e Bobo</strong>.<br>
            Un centro sportivo completo dove puoi praticare tanti sport diversi, 
            divertirti e stare bene.
        </p>
    </section>

    <!-- SPORT DI SQUADRA -->
    <section style="background-color: #f8f9fa;">
        <h2>Sport di squadra</h2>
        <ul>
            <li>Calcio</li>
            <li>Basket</li>
            <li>Pallavolo</li>
            <li>Rugby</li>
        </ul>
    </section>

    <!-- SPORT INDIVIDUALI -->
    <section>
        <h2>Sport individuali</h2>
        <ul>
            <li>Tennis</li>
            <li>Nuoto</li>
            <li>Atletica</li>
            <li>Ciclismo</li>
        </ul>
    </section>

    <!-- SPORT INVERNALI -->
    <section style="background-color: #f8f9fa;">
        <h2>Sport invernali</h2>
        <ul>
            <li>Sci</li>
            <li>Snowboard</li>
            <li>Pattinaggio sul ghiaccio</li>
        </ul>
    </section>

    <!-- SPORT ESTREMI -->
    <section>
        <h2>Sport estremi</h2>
        <ul>
            <li>BMX</li>
            <li>Skateboard</li>
            <li>Arrampicata</li>
        </ul>
    </section>

    <!-- CONTATTI -->
    <section style="background-color: #333; color: white;">
        <h2>Contatti</h2>
        <p style="text-align: center; font-size: 1.3rem;">
            Email: esempio@email.com
        </p>
    </section>

    <footer>
        © Centro Sportivo Albi e Bobo
    </footer>

</body>
</html>